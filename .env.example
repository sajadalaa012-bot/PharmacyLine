# Copy these into your host's environment variables (Railway → Variables).
# These protect the ADMIN back office only — the storefront is public.

# REQUIRED — the email + password used to sign in to the admin.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional — independent secret for signing the session token.
# Defaults to ADMIN_PASSWORD if unset. Set it so tokens don't change
# when you rotate the password.
# AUTH_SECRET=some-long-random-string

# Set automatically by the host (Railway injects PORT). Leave unset locally.
# PORT=8000

# Persistent data directory (SQLite + uploads). The Dockerfile sets this to
# /data — point your mounted volume there.
# DATA_DIR=/data

# Optional — Telegram order notifications.
# The bot token from @BotFather. Set it here and the admin cannot change it
# (the safer option); leave it unset and you can paste it into the app at
# /admin/telegram instead, where it is stored in the database.
# Either way, pick the destination chats at /admin/telegram.
# TELEGRAM_BOT_TOKEN=123456789:AA...

# Optional, local development only. Point `npm run dev` at the deployed API
# instead of this machine's, so the storefront and the back office load real
# products, packages and orders without a local Postgres.
#
# Goes in frontend/.env.local (not here, and not in the host's variables):
#   DEV_API_ORIGIN=https://www.velinaiq.com
#
# Use the exact host the site answers on. velinaiq.com 308-redirects to
# www.velinaiq.com, and proxying to the redirecting host would hand the
# browser a cross-origin hop on every API call.
#
# next.config.ts ignores this outside development, so it cannot affect a
# deployment even if it is set there by mistake.
# DEV_API_ORIGIN=

# Optional - browser push notifications (the phone alert when an order lands).
# A VAPID key pair is what a push service checks before it will deliver.
# Set them here and the admin cannot change them (the safer option); leave
# them unset and the pair can be created with one tap at /admin/notifications,
# where it is stored in the database.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# Optional contact address the push services can complain to.
# VAPID_SUBJECT=mailto:shop@example.com
